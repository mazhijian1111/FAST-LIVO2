<launch>
<!-- =============================================================================
     DD-ESIKF (Project A) — Direction-Decoupled ESIKF on Livox AVIA.
     Launches FAST-LIVO2 with the degeneracy-resilient fusion ENABLED via the
     dd_esikf params in config/dd_esikf.yaml. The base config (avia.yaml) and
     camera config (camera_pinhole.yaml) are unchanged.

     Comparison grid (set dd_esikf/enable and dd_esikf/default_prior_info):
       B0: dd_esikf/enable:=false                 # standard ESIKF (baseline)
       B2: dd_esikf/enable:=true  default_prior_info:=0.0   # mask only
       B3: dd_esikf/enable:=true  default_prior_info:=5.0   # mask + prior floor

     Outputs (when evo/pose_output_en:true in avia.yaml):
       TUM poses -> $(find fast_livo)/Log/result/<seq_name>.txt
     The sweep script copies this into results/<seq>/<method>/poses.txt.
     The DD probe log goes to dd_esikf/log_file (set per-method by the sweep).
     ============================================================================= -->

	<arg name="rviz" default="true" />
	<arg name="dd_enable" default="true" />
	<arg name="dd_prior_info" default="0.0" />
	<arg name="dd_log_file" default="" />
	<arg name="seq_name" default="avia_dd" />

	<!-- Base FAST-LIVO2 params (lidar/imu/extrinsics/lio/vio/...) -->
	<rosparam command="load" file="$(find fast_livo)/config/avia.yaml" />

	<!-- DD-ESIKF params (Project A). Loaded after avia.yaml so dd_esikf/* keys
	     are present for VoxelMapManager::initDegeneracy to read. -->
	<rosparam command="load" file="$(find fast_livo)/config/dd_esikf.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_pinhole.yaml" />
		<!-- Runtime overrides for the comparison sweep (override dd_esikf.yaml) -->
		<param name="dd_esikf/enable"             value="$(arg dd_enable)" />
		<param name="dd_esikf/default_prior_info"  value="$(arg dd_prior_info)" />
		<param name="dd_esikf/log_file"            value="$(arg dd_log_file)" />
		<!-- Override the evo seq_name so each method writes its own pose file. -->
		<param name="evo/seq_name"                 value="$(arg seq_name)" />
	</node>

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
		      args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>

	<node pkg="image_transport" type="republish" name="republish"
	      args="compressed in:=/left_camera/image raw out:=/left_camera/image"
	      output="screen" respawn="true"/>

</launch>
