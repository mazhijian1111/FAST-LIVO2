<launch>
  <!-- FAST-LIVO2 replay configuration for MD3GR Outdoor04.bag. -->
  <arg name="rviz" default="true" />
  <arg name="play_bag" default="false" />
  <arg name="bag" default="/home/mzj/2.dataset/MD3GR/Outdoor04.bag" />
  <arg name="bag_rate" default="1.0" />

  <param name="use_sim_time" value="true" />
  <rosparam command="load" file="$(find fast_livo)/config/Outdoor04.yaml" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_Outdoor04.yaml" />
  </node>

  <!-- The bag stores the RGB stream as sensor_msgs/CompressedImage. -->
  <node pkg="image_transport" type="republish" name="outdoor04_image_decompress"
        args="compressed in:=/camera/color/image_raw raw out:=/outdoor04/camera/color/image_raw"
        output="screen" respawn="true" />

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>

  <group if="$(arg play_bag)">
    <node pkg="rosbag" type="play" name="outdoor04_bag"
          args="--clock -r $(arg bag_rate) $(arg bag)" output="screen" />
  </group>
</launch>
