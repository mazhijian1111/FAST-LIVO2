<launch>
<!-- =============================================================================
     DD-ESIKF (Project A) — Direction-Decoupled ESIKF on MD3GR Outdoor04.bag.
     Mirrors mapping_avia_dd.launch but loads the Outdoor04 base config
     (config/Outdoor04.yaml) + camera config (config/camera_Outdoor04.yaml)
     and keeps the Outdoor04 image-decompress node (the bag stores the RGB
     stream as sensor_msgs/CompressedImage).

     Comparison grid (set dd_esikf/enable and dd_esikf/default_prior_info):
       B0: dd_esikf/enable:=false                 # standard ESIKF (baseline)
       B2: dd_esikf/enable:=true  default_prior_info:=0.0   # mask only
       B3: dd_esikf/enable:=true  default_prior_info:=5.0   # mask + prior floor

     Outputs (when evo/pose_output_en:true in Outdoor04.yaml):
       TUM poses -> $(find fast_livo)/Log/result/<seq_name>.txt
     The sweep script copies this into results/<seq>/<method>/poses.txt.
     The DD probe log goes to dd_esikf/log_file (set per-method by the sweep).
     ============================================================================= -->

	<arg name="rviz" default="true" />
	<arg name="play_bag" default="false" />
	<arg name="bag" default="/home/mzj/2.dataset/MD3GR/Outdoor04.bag" />
	<arg name="bag_rate" default="1.0" />

	<arg name="dd_enable" default="true" />
	<arg name="dd_prior_info" default="0.0" />
	<arg name="dd_log_file" default="" />
	<arg name="seq_name" default="Outdoor04_dd" />
	<!-- Layer 4 (T4 FEJ) and RR-IESKF Axis I (DFEJ) runtime overrides.
	     dfej takes precedence over fej when both are true (and dd_enable=true). -->
	<arg name="fej_enable" default="" />
	<arg name="dfej_enable" default="" />
	<!-- RR-IESKF Axis I extras: real IMU prior and external anchor (M4).
	     Toggled from the research sweep without editing dd_esikf.yaml. -->
	<arg name="imu_prior_enable" default="" />
	<arg name="anchor_enable" default="" />
	<arg name="anchor_lambda" default="" />
	<!-- Explicit experiment controls.  Empty keeps the YAML value; the
	     baseline runner sets every one so B0 is genuinely enhancement-free. -->
	<arg name="adaptive_enable" default="" />
	<arg name="aniso_enable" default="" />
	<arg name="map_gate_enable" default="" />
	<arg name="comp_sweep_enable" default="" />
	<arg name="submap_enable" default="" />
	<arg name="robust_vio_enable" default="" />
	<arg name="cross_modal_select_enable" default="" />
	<arg name="gate_enable" default="" />
	<arg name="dist_noise_enable" default="" />
	<!-- §2.2 whitened degeneracy criterion (W = S Λ_f S, S = (P^-)^{1/2}).
	     Empty keeps the YAML default (false = raw criterion). Read the
	     "READ THIS BEFORE ENABLING" note in dd_esikf.yaml first: on this bag the
	     whitened criterion fires on 0.72% of frames where the raw one fires on
	     100%, so enabling it makes the DD mask nearly inert — the intended
	     prediction of such a run is ATE → the non-DD baseline. -->
	<arg name="whiten_enable" default="" />

	<param name="use_sim_time" value="true" />

	<!-- Base FAST-LIVO2 params (lidar/imu/extrinsics/lio/vio/... for MD3GR) -->
	<rosparam command="load" file="$(find fast_livo)/config/Outdoor04.yaml" />

	<!-- DD-ESIKF params (Project A). Loaded after Outdoor04.yaml so dd_esikf/*
	     keys are present for VoxelMapManager::initDegeneracy to read. -->
	<rosparam command="load" file="$(find fast_livo)/config/dd_esikf.yaml" />

	<!-- Override the evo seq_name so each method writes its own pose file.
	     IMPORTANT: LIVMapper reads this via a GLOBAL NodeHandle
	     (main.cpp: ros::NodeHandle nh), so this param must be at launch-file
	     (global) scope — inside <node> it would land in /laserMapping/evo/*
	     and never be read. dd_esikf/* inside <node> works the same way ONLY
	     because initDegeneracy also uses the global nh; but the rosparam
	     dump shows both ns — keep both scopes consistent here. -->
	<param name="evo/seq_name"                 value="$(arg seq_name)" />
	<param name="evo/pose_output_en"           value="true" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_Outdoor04.yaml" />
		<!-- Runtime overrides for the comparison sweep (override dd_esikf.yaml).
		     NOTE: these land in /laserMapping/dd_esikf/*, but VoxelMapManager::
		     initDegeneracy is ALSO given the global nh, and NodeHandle param
		     lookups resolve relative to the handle's namespace — the global nh
		     used by main.cpp resolves "dd_esikf/enable" to /dd_esikf/enable.
		     So ALSO mirror the overrides at global scope below. -->
	</node>

	<!-- Global-scope mirrors of the runtime overrides (read via the global nh). -->
	<param name="dd_esikf/enable"              value="$(arg dd_enable)" />
	<param name="dd_esikf/default_prior_info"  value="$(arg dd_prior_info)" />
	<param name="dd_esikf/log_file"            value="$(arg dd_log_file)" />
	<param if="$(eval fej_enable != '')" name="dd_esikf/fej_enable"    value="$(arg fej_enable)" />
	<param if="$(eval dfej_enable != '')" name="dd_esikf/dfej_enable"  value="$(arg dfej_enable)" />
	<param if="$(eval imu_prior_enable != '')" name="dd_esikf/imu_prior_enable" value="$(arg imu_prior_enable)" />
	<param if="$(eval anchor_enable != '')" name="dd_esikf/anchor_enable"       value="$(arg anchor_enable)" />
	<param if="$(eval anchor_lambda != '')" name="dd_esikf/anchor_lambda"       value="$(arg anchor_lambda)" />
	<param if="$(eval adaptive_enable != '')" name="dd_esikf/adaptive_enable" value="$(arg adaptive_enable)" />
	<param if="$(eval aniso_enable != '')" name="dd_esikf/aniso_enable" value="$(arg aniso_enable)" />
	<param if="$(eval map_gate_enable != '')" name="dd_esikf/map_gate_enable" value="$(arg map_gate_enable)" />
	<param if="$(eval comp_sweep_enable != '')" name="dd_esikf/comp_sweep_enable" value="$(arg comp_sweep_enable)" />
	<param if="$(eval submap_enable != '')" name="dd_esikf/submap_enable" value="$(arg submap_enable)" />
	<param if="$(eval robust_vio_enable != '')" name="vio/robust_vio_enable" value="$(arg robust_vio_enable)" />
	<param if="$(eval cross_modal_select_enable != '')" name="vio/cross_modal_select_enable" value="$(arg cross_modal_select_enable)" />
	<param if="$(eval gate_enable != '')" name="vio/gate_enable" value="$(arg gate_enable)" />
	<param if="$(eval dist_noise_enable != '')" name="imu/dist_noise_enable" value="$(arg dist_noise_enable)" />
	<param if="$(eval whiten_enable != '')" name="dd_esikf/whiten_enable" value="$(arg whiten_enable)" />

	<!-- The bag stores the RGB stream as sensor_msgs/CompressedImage. -->
	<node pkg="image_transport" type="republish" name="outdoor04_image_decompress"
	      args="compressed in:=/camera/color/image_raw raw out:=/outdoor04/camera/color/image_raw"
	      output="screen" respawn="true" />

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
		      args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>

	<group if="$(arg play_bag)">
		<node pkg="rosbag" type="play" name="outdoor04_bag"
		      args="--clock -r $(arg bag_rate) $(arg bag)" output="screen" />
	</group>

</launch>
